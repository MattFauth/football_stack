# ==============================================================
# Aplicação / pipeline
# ==============================================================
APP_ENV=development
APP_VERSION=dev
TZ=America/Araguaina

DATASET_HANDLE=davidcariboo/player-scores
KAGGLE_API_TOKEN=

PYTHON_VERSION=3.12.13
APP_UID=10001
APP_GID=10001

DBT_TARGET=dev
DBT_THREADS=4

PIPELINE_CPUS=4.0
PIPELINE_MEMORY=8g
DOWNLOAD_CPUS=2.0
DOWNLOAD_MEMORY=4g
TEST_CPUS=2.0
TEST_MEMORY=4g

JUPYTER_PORT=8888
JUPYTER_TOKEN=troque-esta-senha
JUPYTER_CPUS=4.0
JUPYTER_MEMORY=8g

DBT_DOCS_PORT=8080
DOCS_CPUS=1.0
DOCS_MEMORY=2g

# ==============================================================
# Warehouse PostgreSQL
# ==============================================================
FOOTBALL_DB_VERSION=18.4
FOOTBALL_DB_NAME=football
FOOTBALL_DB_USER=football
FOOTBALL_DB_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE

# Porta acessível apenas no host local. Internamente continua 5432.
FOOTBALL_DB_HOST_PORT=5433

FOOTBALL_DB_CPUS=4.0
FOOTBALL_DB_MEMORY=4g
FOOTBALL_DB_MAX_CONNECTIONS=100
FOOTBALL_DB_SHARED_BUFFERS=256MB
FOOTBALL_DB_EFFECTIVE_CACHE_SIZE=1GB
FOOTBALL_DB_MAINTENANCE_WORK_MEM=128MB
FOOTBALL_DB_WORK_MEM=8MB
FOOTBALL_DB_MAX_WAL_SIZE=2GB
FOOTBALL_DB_CHECKPOINT_TIMEOUT=15min

# ==============================================================
# Superset
# ==============================================================
SUPERSET_VERSION=6.0.0
SUPERSET_PORT=8088

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SUPERSET_SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_LONGA

SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_FIRSTNAME=Football
SUPERSET_ADMIN_LASTNAME=Admin
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_ADMIN_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE

# O Superset 6.0 documenta suporte ao metastore até PostgreSQL 16.
SUPERSET_POSTGRES_VERSION=16.14
SUPERSET_DB_NAME=superset
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE

SUPERSET_REDIS_VERSION=8.8.0
SUPERSET_REDIS_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE

SUPERSET_WEBSERVER_WORKERS=2
SUPERSET_WEBSERVER_THREADS=20
SUPERSET_WEBSERVER_TIMEOUT=120
SUPERSET_CELERY_WORKERS=2
SUPERSET_LOG_LEVEL=INFO

SUPERSET_WEB_CPUS=2.0
SUPERSET_WEB_MEMORY=3g
SUPERSET_WORKER_CPUS=2.0
SUPERSET_WORKER_MEMORY=3g
SUPERSET_BEAT_CPUS=0.5
SUPERSET_BEAT_MEMORY=1g
