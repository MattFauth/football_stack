  create view "football"."staging"."stg_clubs__dbt_tmp"
    
    
  as (
    with source as (
    select * from "football"."raw"."clubs"
),

renamed as (
    select
        -- IDs
        cast(club_id as integer) as club_id,
        
        -- Strings
        club_code,
        name,
        domestic_competition_id,
        stadium_name,
