  create  table "football"."marts"."dim_competitions__dbt_tmp"
  
  
    as
  
  (
    with competitions as (
    select * from "football"."staging"."stg_competitions"
),
countries as (
    select * from "football"."staging"."stg_countries"
)

select
    c.competition_id,
