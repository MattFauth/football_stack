  create view "football"."staging_staging"."stg_players__dbt_tmp"
    
    
  as (
    with source as (
    select * from "football"."raw"."players"
),

renamed as (
    select
        -- IDs
        cast(player_id as integer) as player_id,
        cast(nullif(current_club_id, '') as integer) as current_club_id,
        cast(nullif(current_national_team_id, '') as integer) as current_national_team_id,
        
        -- Strings
        first_name,
        last_name,
        name,
        player_code,
        country_of_birth,
        city_of_birth,
        country_of_citizenship,
        sub_position,
        position,
        foot,
        agent_name,
        image_url,
        url,
        current_club_domestic_competition_id,
        current_club_name,
        
        -- Dates/Times
        cast(nullif(date_of_birth, '') as date) as date_of_birth,
        cast(nullif(contract_expiration_date, '') as timestamp) as contract_expiration_date,
        
        -- Numerics
        cast(nullif(last_season, '') as integer) as last_season,
        cast(nullif(height_in_cm, '') as integer) as height_in_cm,
        cast(nullif(international_caps, '') as integer) as international_caps,
        cast(nullif(international_goals, '') as integer) as international_goals,
        cast(nullif(market_value_in_eur, '') as numeric) as market_value_in_eur,
        cast(nullif(highest_market_value_in_eur, '') as numeric) as highest_market_value_in_eur

    from source
)

